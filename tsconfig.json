{
  "compilerOptions": {
    "module": "ES2020",
    "esModuleInterop": true,
    "target": "es2020",
    "moduleResolution": "node",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "strictNullChecks": true,
    "noImplicitAny": true
  },
  "include": [
    "src/**/*"
  ]
}
