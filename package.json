{
  "name": "tstruco",
  "version": "1.0.0-beta.2",
  "description": "",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "tsc --build --clean && jest --verbose",
    "test:coverage": "jest --coverage",
    "test:badges": "pnpm run test:coverage  && jest-coverage-badges output './badges'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --ignore-path .gitignore --write \"./src/**/*.+(js|ts|json)\"",
    "prettier:fix": "prettier --write src",
    "build": "rm -rf dist && node build.js && tsc --emitDeclarationOnly"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gabtar/tstruco"
  },
  "keywords": [
    "truco",
    "truco argentino",
    "card game"
  ],
  "author": "Gabriel Tarifa",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.3",
    "@types/node": "^20.4.5",
    "@typescript-eslint/eslint-plugin": "^8.4.0",
    "@typescript-eslint/parser": "^8.4.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.10.0",
    "jest": "^29.6.2",
    "jest-coverage-badges": "^1.1.2",
    "prettier": "^3.3.3",
    "ts-jest": "^29.1.1",
    "typescript": "^5.1.6",
    "typescript-eslint": "^8.23.0"
  }
}
